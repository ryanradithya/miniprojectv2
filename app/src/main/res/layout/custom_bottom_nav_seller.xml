<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingTop="20dp"
    android:background="@drawable/bg_navbar_rounded"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- ============================= -->
        <!-- LIST PRODUK -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/nav_list_produk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:translationY="-30dp">

                <View
                    android:id="@+id/nav_list_produk_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_circle"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/nav_list_produk_icon"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_list"
                    android:translationY="12dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/nav_list_produk_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List Produk"
                android:textSize="14sp"
                android:layout_marginTop="-30dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ============================= -->
        <!-- TAMBAH PRODUK -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/nav_tambah_produk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:translationY="-30dp">

                <View
                    android:id="@+id/nav_tambah_produk_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_circle"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/nav_tambah_produk_icon"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_add"
                    android:translationY="12dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/nav_tambah_produk_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah Produk"
                android:textSize="14sp"
                android:layout_marginTop="-30dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ============================= -->
        <!-- PESANAN -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/nav_pesanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:translationY="-30dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/nav_pesanan_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_circle"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/nav_pesanan_icon"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_orders"
                    android:translationY="12dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/nav_pesanan_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan"
                android:textSize="14sp"
                android:layout_marginTop="-30dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ============================= -->
        <!-- AKUN -->
        <!-- ============================= -->
        <LinearLayout
            android:id="@+id/nav_account_seller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:translationY="-30dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/nav_account_seller_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_circle"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/nav_account_seller_icon"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_person"
                    android:translationY="12dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/nav_account_seller_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akun"
                android:textSize="14sp"
                android:layout_marginTop="-30dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
