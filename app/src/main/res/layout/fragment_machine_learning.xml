<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/defaultDescriptionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/defaultDescription"
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:background="@drawable/bg_info_box"
            android:textAlignment="center" />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah Peminjaman"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/etLoanAmount"
            android:hint=""
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah Pembayaran per Bulan"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/etInstallment"
            android:hint=""
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pendapatan Tahunan"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <EditText
            android:id="@+id/etAnnualIncome"
            android:hint="Pendapat dalam 1 tahun (dalam dollar)"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lama Menyicil"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerTerm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nilai Rating"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerGrade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipe Home Ownership"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerHomeOwnership"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status Verifikasi"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerVerification"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tujuan Meminjam"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerPurpose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"/>

<!-- submit button-->
        <Button
            android:id="@+id/btnPredict"
            android:text="Predict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="Idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- Prediction -->
        <TextView
            android:id="@+id/tvPrediction"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textAlignment="center"/>

        <!-- Explanation -->
        <TextView
            android:id="@+id/tvExplanation"
            android:text=""
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>

    </LinearLayout>
</ScrollView>
